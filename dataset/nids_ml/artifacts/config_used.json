{
  "artifacts": {
    "out_dir": "./artifacts"
  },
  "attack_paths": {
    "test": "../attack/test.json",
    "train": "../attack/train.json",
    "val": "../attack/val.json"
  },
  "benign_paths": {
    "test": "../benign/test.json",
    "train": "../benign/train.json",
    "val": "../benign/val.json"
  },
  "data": {
    "buffer_field": "buffers",
    "fallback_header_len": 512,
    "fixed_len": 1024,
    "sep_byte": 30
  },
  "model": {
    "channels": 96,
    "dilations": [
      1,
      2,
      4,
      8
    ],
    "dropout": 0.1,
    "embed_dim": 32,
    "fusion_dim": 256,
    "kernel": 5,
    "prefix_lengths": [
      64,
      128,
      256,
      512
    ],
    "proj_dim": 192,
    "type": "tcn_2way"
  },
  "seed": 123456,
  "training": {
    "batch_size": 256,
    "clip_grad": 1.0,
    "lr": 0.0001,
    "max_epochs_pretrain": 30,
    "max_epochs_pu": 30,
    "num_workers": 0,
    "patience": 5,
    "pi_p": 0.1,
    "temp": 0.2,
    "w_alert": 0.2,
    "w_pu": 1.0,
    "w_ssl": 1.5,
    "weight_decay": 0.0001
  }
}